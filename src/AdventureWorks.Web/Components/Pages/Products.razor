@page "/products"
@rendermode InteractiveServer
@using System.Linq.Expressions
@using AdventureWorks.Web.Models
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<AdventureWorksContext> DbFactory

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<p class="query-method">
    <strong>Query method: LINQ.</strong> The <code>Production.Product</code> query is built from <code>IQueryable</code> operators
    (<code>Where</code>, <code>OrderBy</code>, <code>Skip</code>/<code>Take</code>, <code>CountAsync</code>), which EF translates
    to SQL with parameters, sorting and paging all done in the database.
</p>

<div class="d-flex flex-wrap align-items-center gap-3 mb-2">
    @* type="search" gets the browser's built-in clear button, which raises an input event like typing does *@
    <input type="search" class="form-control form-control-sm product-search" placeholder="Search name or product #" aria-label="Search products"
           @bind="searchText" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />

    <label class="d-flex align-items-center gap-2 mb-0">
        Show
        <select class="form-select form-select-sm w-auto" @bind="pageSize" @bind:after="OnPageSizeChangedAsync">
            @foreach (int size in PageSizes)
            {
                <option value="@size">@size</option>
            }
        </select>
        per page
    </label>

    @if (totalCount > 0)
    {
        <span class="text-muted small">
            Showing @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, totalCount) of @totalCount
        </span>
    }
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    @foreach (Column column in Columns)
                    {
                        <th class="@(column.AlignEnd ? "text-end" : null)" aria-sort="@AriaSort(column.Key)">
                            <button type="button" class="sort-button" @onclick="() => SortByAsync(column.Key)">
                                @column.Title<span class="sort-indicator" aria-hidden="true">@SortIndicator(column.Key)</span>
                            </button>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (products.Count == 0)
                {
                    <tr>
                        <td colspan="@Columns.Length" class="text-muted"><em>No products match "@searchText".</em></td>
                    </tr>
                }
                @foreach (Product p in products)
                {
                    <tr>
                        <td>@p.ProductId</td>
                        <td>@p.Name</td>
                        <td>@p.ProductNumber</td>
                        <td>@p.Color</td>
                        <td class="text-end">@p.StandardCost.ToString("C", usd)</td>
                        <td class="text-end">@p.ListPrice.ToString("C", usd)</td>
                        <td>@p.Size</td>
                        <td>@p.SellStartDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pager CurrentPage="currentPage" TotalPages="totalPages" OnPageSelected="GoToPageAsync" AriaLabel="Product pages" />
}

@code {
    private sealed record Column(string Key, string Title, bool AlignEnd = false);

    private static readonly Column[] Columns =
    [
        new(nameof(Product.ProductId), "ID"),
        new(nameof(Product.Name), "Name"),
        new(nameof(Product.ProductNumber), "Product #"),
        new(nameof(Product.Color), "Color"),
        new(nameof(Product.StandardCost), "Standard Cost", AlignEnd: true),
        new(nameof(Product.ListPrice), "List Price", AlignEnd: true),
        new(nameof(Product.Size), "Size"),
        new(nameof(Product.SellStartDate), "Sell Start"),
    ];

    private static readonly int[] PageSizes = [10, 25, 50, 100];
    private static readonly System.Globalization.CultureInfo usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private List<Product>? products;
    private string? error;
    private int pageSize = 25;
    private int currentPage = 1;
    private int totalCount;
    private int totalPages;
    private string sortColumn = nameof(Product.ProductId);
    private bool sortDescending;
    private string searchText = "";
    private CancellationTokenSource? searchDebounce;

    // Incremented per load so a slow response can't overwrite the results of a newer request
    private int loadVersion;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnSearchChangedAsync()
    {
        // Wait for a pause in typing so each keystroke doesn't trigger a query
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, searchDebounce.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        currentPage = 1;
        await LoadAsync();
    }

    private Task OnPageSizeChangedAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task SortByAsync(string column)
    {
        sortDescending = column == sortColumn && !sortDescending;
        sortColumn = column;
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage)
        {
            return Task.CompletedTask;
        }

        currentPage = page;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        int version = ++loadVersion;

        try
        {
            await using AdventureWorksContext db = await DbFactory.CreateDbContextAsync();
            IQueryable<Product> query = db.Products.AsNoTracking();

            string term = searchText.Trim();
            if (term.Length > 0)
            {
                // Translates to LIKE '%term%' (wildcards in the term are escaped); case-insensitive under the default collation
                query = query.Where(p => p.Name.Contains(term) || p.ProductNumber.Contains(term));
            }

            int count = await query.CountAsync();
            int pages = Math.Max(1, (int)Math.Ceiling(count / (double)pageSize));
            int page = Math.Clamp(currentPage, 1, pages);

            List<Product> items = await ApplySort(query)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            if (version != loadVersion)
            {
                return;
            }

            (products, totalCount, totalPages, currentPage, error) = (items, count, pages, page, null);
        }
        catch (Exception ex)
        {
            if (version == loadVersion)
            {
                error = $"Could not load products: {ex.Message}";
            }
        }
    }

    private IQueryable<Product> ApplySort(IQueryable<Product> query)
    {
        IOrderedQueryable<Product> sorted = sortColumn switch
        {
            nameof(Product.Name) => Order(query, p => p.Name),
            nameof(Product.ProductNumber) => Order(query, p => p.ProductNumber),
            nameof(Product.Color) => Order(query, p => p.Color),
            nameof(Product.StandardCost) => Order(query, p => p.StandardCost),
            nameof(Product.ListPrice) => Order(query, p => p.ListPrice),
            nameof(Product.Size) => Order(query, p => p.Size),
            nameof(Product.SellStartDate) => Order(query, p => p.SellStartDate),
            _ => Order(query, p => p.ProductId),
        };

        // Tie-breaker keeps paging stable when sorting by a non-unique column
        return sorted.ThenBy(p => p.ProductId);
    }

    private IOrderedQueryable<Product> Order<TKey>(IQueryable<Product> query, Expression<Func<Product, TKey>> key) =>
        sortDescending ? query.OrderByDescending(key) : query.OrderBy(key);

    private string SortIndicator(string column) =>
        column != sortColumn ? "" : sortDescending ? " ▼" : " ▲";

    private string? AriaSort(string column) =>
        column != sortColumn ? null : sortDescending ? "descending" : "ascending";

    public void Dispose()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
    }
}
