@page "/products"
@rendermode InteractiveServer
@using AdventureWorks.Web.Models
@using Microsoft.EntityFrameworkCore
@inject AdventureWorksContext Db

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<p>Top 50 records from <code>Production.Product</code>.</p>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped table-hover table-sm">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Product #</th>
                <th>Color</th>
                <th class="text-end">Standard Cost</th>
                <th class="text-end">List Price</th>
                <th>Size</th>
                <th>Sell Start</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr>
                    <td>@p.ProductId</td>
                    <td>@p.Name</td>
                    <td>@p.ProductNumber</td>
                    <td>@p.Color</td>
                    <td class="text-end">@p.StandardCost.ToString("C", usd)</td>
                    <td class="text-end">@p.ListPrice.ToString("C", usd)</td>
                    <td>@p.Size</td>
                    <td>@p.SellStartDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;
    private string? error;
    private static readonly System.Globalization.CultureInfo usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Db.Products
                .AsNoTracking()
                .OrderBy(p => p.ProductId)
                .Take(50)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load products: {ex.Message}";
        }
    }
}
