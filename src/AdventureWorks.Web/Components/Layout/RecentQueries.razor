@using AdventureWorks.Web.Services
@implements IDisposable
@inject RecentQueryFeed Feed

<section class="recent-queries">
    <header>
        <strong>Recent SQL</strong>
        <small class="text-muted">last @Count batches from sys.dm_exec_query_stats, newest first, refreshed every @IntervalSeconds s</small>
        <div class="form-check form-switch mb-0 app-filter">
            <input class="form-check-input" type="checkbox" role="switch" id="recent-queries-this-app"
                   @bind="thisAppOnly" @bind:after="() => RefreshAsync(cts.Token)" />
            <label class="form-check-label" for="recent-queries-this-app">This app only</label>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm reset-button" @onclick="ResetAsync" disabled="@resetting"
                title="Clear this database's plan cache (ALTER DATABASE SCOPED CONFIGURATION CLEAR PROCEDURE_CACHE)">
            @(resetting ? "Resetting..." : "Reset")
        </button>
    </header>

    @if (error is not null)
    {
        <div class="alert alert-danger py-1 px-2 mb-0">@error</div>
    }
    else if (queries is null)
    {
        <p class="text-muted mb-0"><em>Connecting...</em></p>
    }
    else if (queries.Count == 0)
    {
        <p class="text-muted mb-0"><em>No queries in the plan cache yet.</em></p>
    }
    else
    {
        <ol class="list-unstyled mb-0">
            @foreach (RecentQuery q in queries)
            {
                <li>
                    <div class="meta">
                        <span>@FormatAgo(q.SecondsAgoMs)</span>
                        <span>@q.LastExecutionTime.ToString("HH:mm:ss.fff")</span>
                        <span>@q.ExecutionCount× executed</span>
                        <span>avg @q.AvgElapsedMs.ToString("0.##") ms</span>
                        @if (q.SourceUrl is not null)
                        {
                            <a class="source-link" href="@q.SourceUrl" target="_blank" rel="noopener noreferrer"
                               title="View calling code on GitHub" aria-label="View calling code on GitHub">
                                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
                                    <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                                </svg>
                            </a>
                        }
                    </div>
                    <pre>@q.SqlText.Trim()</pre>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter] public int Count { get; set; } = 10;
    [Parameter] public int IntervalSeconds { get; set; } = 2;

    private readonly CancellationTokenSource cts = new();
    private IReadOnlyList<RecentQuery>? queries;
    private string? error;
    private bool resetting;
    private bool thisAppOnly = true;

    protected override void OnAfterRender(bool firstRender)
    {
        // Only runs once the component is interactive (never during prerendering)
        if (firstRender)
        {
            _ = PollAsync(cts.Token);
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(IntervalSeconds));
            do
            {
                await RefreshAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
            while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // Component disposed
        }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            queries = await Feed.GetRecentAsync(Count, thisAppOnly, cancellationToken);
            error = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            error = $"Could not read recent queries: {ex.Message}";
        }
    }

    private async Task ResetAsync()
    {
        resetting = true;
        try
        {
            await Feed.ClearPlanCacheAsync(cts.Token);
            await RefreshAsync(cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            error = $"Could not clear the plan cache: {ex.Message}";
        }
        finally
        {
            resetting = false;
        }
    }

    private static string FormatAgo(long ms) => ms switch
    {
        < 1000 => "just now",
        < 60_000 => $"{ms / 1000}s ago",
        < 3_600_000 => $"{ms / 60_000}m ago",
        _ => $"{ms / 3_600_000}h ago"
    };

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
